# Required: use a long, unique password and secret. Never commit .env.
APP_PASSWORD=change-this-before-starting
SESSION_SECRET=replace-with-a-long-random-secret

# Optional public hostname, used with compose.prod.yaml.
DOMAIN=research.example.com
APP_PORT=8000

# Worker and storage policy.
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=10
RETENTION_DAYS=30

# Browser crawler is installed in the Docker image. Set to 1 to use only
# public APIs and search fallbacks; set to 0 to enable Playwright (default).
LAST30DAYS_DISABLE_BROWSER=0

# Optional source credentials. Keep them only in deployment secrets/.env.
WEIBO_ACCESS_TOKEN=
SCRAPECREATORS_API_KEY=
ZHIHU_COOKIE=
TIKHUB_API_KEY=
DOUYIN_API_KEY=
WECHAT_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
